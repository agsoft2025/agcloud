# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Observability ─────────────────────────────────────────────────────────────
# OpenTelemetry trace export. Leave unset to disable tracing entirely (no
# startup cost, no connection errors) — e.g. local dev without a collector.
# When set, traces are exported to `${OTEL_EXPORTER_OTLP_ENDPOINT}/v1/traces`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/agcloud
REDIS_URL=redis://localhost:6379

# ── LiveKit ───────────────────────────────────────────────────────────────────
# Server-to-server URL (room management / egress)
LIVEKIT_URL=wss://your-project.livekit.cloud
# Public WebSocket URL returned to browsers/apps (omit if same as LIVEKIT_URL)
# In Docker: LIVEKIT_URL=ws://livekit:7880  and  LIVEKIT_PUBLIC_URL=wss://livekit.yourapp.com
LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use: openssl rand -hex 32
JWT_SECRET=replace_me_with_at_least_32_char_secret
JWT_REFRESH_SECRET=replace_me_with_different_32_char_secret
# Short-lived access token. Recommended: 15m
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
# Refresh token sliding lifetime (extended on every successful rotation)
REFRESH_TOKEN_TTL_DAYS=7
# Absolute session cap from first login, regardless of activity/rotation
REFRESH_TOKEN_FAMILY_MAX_AGE_DAYS=30

# ── App ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins in production
FRONTEND_URL=http://localhost:5173

# ── FCM (Android / Web push notifications) ───────────────────────────────────
# From Firebase Console → Project Settings → Service Accounts → Generate new private key
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── APNs (iOS push notifications) ────────────────────────────────────────────
# From Apple Developer Portal → Certificates, Identifiers & Profiles → Keys
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# APNS_BUNDLE_ID=com.yourcompany.yourapp
# APNS_PRODUCTION=false

# ── Email (password reset) ───────────────────────────────────────────────────
# Leave unset to log reset links to the console instead of sending real email
# (default in dev/test). Set SMTP_HOST to enable real delivery.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_SECURE=false
# SMTP_FROM=no-reply@yourapp.com
