# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/agcloud
REDIS_URL=redis://localhost:6379

# ── LiveKit ───────────────────────────────────────────────────────────────────
# Server-to-server URL (room management / egress)
LIVEKIT_URL=wss://your-project.livekit.cloud
# Public WebSocket URL returned to browsers/apps (omit if same as LIVEKIT_URL)
# In Docker: LIVEKIT_URL=ws://livekit:7880  and  LIVEKIT_PUBLIC_URL=wss://livekit.yourapp.com
LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use: openssl rand -hex 32
JWT_SECRET=replace_me_with_at_least_32_char_secret
JWT_REFRESH_SECRET=replace_me_with_different_32_char_secret
# Short-lived access token. Recommended: 15m
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# ── App ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins in production
FRONTEND_URL=http://localhost:5173

# ── FCM (Android / Web push notifications) ───────────────────────────────────
# From Firebase Console → Project Settings → Service Accounts → Generate new private key
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── APNs (iOS push notifications) ────────────────────────────────────────────
# From Apple Developer Portal → Certificates, Identifiers & Profiles → Keys
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# APNS_BUNDLE_ID=com.yourcompany.yourapp
# APNS_PRODUCTION=false
