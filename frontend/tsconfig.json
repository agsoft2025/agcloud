{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "types": ["svelte"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "baseUrl": "."
  },
  "include": ["src/**/*", "src/node_modules/**/*"],
  "exclude": ["node_modules"]
}
